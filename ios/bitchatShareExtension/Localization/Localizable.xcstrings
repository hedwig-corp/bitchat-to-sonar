  "strings": {
    "share.status.failed_to_stage": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر تجهيز ما شاركته",
            "comment": "Shown when the shared content cannot be written to the shared container"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "geteilter inhalt konnte nicht vorbereitet werden",
            "comment": "Shown when the shared content cannot be written to the shared container"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "couldn't prepare what you shared",
            "comment": "Shown when the shared content cannot be written to the shared container"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "no se pudo preparar lo que compartiste",
            "comment": "Shown when the shared content cannot be written to the shared container"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "impossible de préparer le contenu partagé",
