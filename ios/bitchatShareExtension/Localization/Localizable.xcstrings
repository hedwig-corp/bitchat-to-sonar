          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "tidak bisa menyiapkan konten yang dibagikan",
            "comment": "Shown when the shared content cannot be written to the shared container"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "impossibile preparare il contenuto condiviso",
            "comment": "Shown when the shared content cannot be written to the shared container"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "共有された内容を準備できませんでした",
