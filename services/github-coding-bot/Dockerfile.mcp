# syntax=docker/dockerfile:1.7
FROM rust:1.92-bookworm AS builder
WORKDIR /source
COPY . .
RUN cargo build --locked --release -p coding-bot-server --bin hermes-github-mcp

FROM debian:bookworm-slim AS runtime
RUN apt-get update \
    && apt-get install --yes --no-install-recommends ca-certificates docker.io \
    && rm -rf /var/lib/apt/lists/* \
    && useradd --create-home --uid 10001 --shell /usr/sbin/nologin hermes-github
COPY --from=builder /source/target/release/hermes-github-mcp /usr/local/bin/hermes-github-mcp
USER 10001:10001
ENTRYPOINT ["/usr/local/bin/hermes-github-mcp"]
