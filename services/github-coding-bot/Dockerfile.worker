# syntax=docker/dockerfile:1.7
# Untrusted repository code runs in this image. It deliberately contains no
# Docker client, SSH client, cloud CLI, credentials, or network download tools.
FROM rust:1.92-bookworm
RUN apt-get update \
    && apt-get install --yes --no-install-recommends \
        build-essential \
        ca-certificates \
        git \
        golang-go \
        make \
        nodejs \
        npm \
        pkg-config \
        python3 \
        python3-pytest \
        ripgrep \
    && rm -rf /var/lib/apt/lists/* \
    && npm install --global pnpm@10.13.1 \
    && useradd --create-home --uid 10001 --shell /usr/sbin/nologin worker \
    && useradd --create-home --uid 10002 --gid worker --shell /usr/sbin/nologin publisher \
    && mkdir --parents /workspace \
    && chown worker:worker /workspace
USER 10001:10001
WORKDIR /workspace
CMD ["true"]
