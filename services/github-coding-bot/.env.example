# Copy to .env. Never commit .env, private keys, or real tokens.
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_PORT=5432
DATABASE_URL=postgres://coding_bot:replace-password@127.0.0.1:5432/coding_bot

RUN_MODE=all
LISTEN_ADDR=127.0.0.1:8080
API_PORT=8080
ADMIN_API_TOKEN=replace-with-a-long-random-token

GITHUB_APP_ID=123456
GITHUB_PRIVATE_KEY_PATH=/absolute/path/to/github-app.private-key.pem
GITHUB_PRIVATE_KEY_FILE=/absolute/path/to/github-app.private-key.pem
GITHUB_WEBHOOK_SECRET=replace-with-a-long-random-webhook-secret
GITHUB_BOT_LOGIN=your-app-name[bot]
GITHUB_API_BASE_URL=https://api.github.com
GITHUB_WEB_BASE_URL=https://github.com
REPOSITORY_ALLOWLIST=owner/repository,owner/another-repository

LLM_API_KEY=replace-with-provider-key
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=replace-with-model-id

MAX_AGENT_STEPS=40
MAX_FILES_READ=200
MAX_FILES_MODIFIED=25
MAX_DIFF_LINES=1500
MAX_LLM_TOKENS=120000
MAX_RETRY_COUNT=3
MAX_TOOL_OUTPUT_BYTES=65536
JOB_TIMEOUT_SECONDS=3600
COMMAND_TIMEOUT_SECONDS=900

WORKER_IMAGE=sonar-github-coding-bot-sandbox:local
DOCKER_BINARY=docker
DOCKER_GID=0
WORKER_NETWORK=bridge
WORKER_MEMORY=4g
WORKER_CPUS=2
WORKER_PIDS_LIMIT=256
WORKER_WORKSPACE_SIZE=8g
WORKER_POLL_SECONDS=2
WORKER_LEASE_SECONDS=60
BLOCKED_PATHS=.github/workflows/**,.github/actions/**,CODEOWNERS,.github/CODEOWNERS,**/CODEOWNERS,deploy/**,infrastructure/**,infra/**,k8s/**,helm/**,.git/**,.githooks/**,.ai-fix.toml,.env*,**/.env*,*secret*,**/*secret*,*credentials*,**/*credentials*,*token*,**/*token*,Dockerfile*,**/Dockerfile*,docker-compose*.yml,**/docker-compose*.yml,*.tf,**/*.tf,.gitlab-ci.yml

RUST_LOG=info
