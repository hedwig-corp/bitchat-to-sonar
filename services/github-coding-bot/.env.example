# Copy to .env. Never commit .env, private keys, or real credentials.
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_PORT=5432
DATABASE_URL=postgres://hermes_github:replace-password@127.0.0.1:5432/hermes_github

GITHUB_APP_ID=123456
GITHUB_PRIVATE_KEY_PATH=/absolute/path/to/github-app.private-key.pem
GITHUB_PRIVATE_KEY_FILE=/absolute/path/to/github-app.private-key.pem
GITHUB_API_BASE_URL=https://api.github.com
GITHUB_WEB_BASE_URL=https://github.com

# Exact, comma-separated Sonar sender identifiers supplied by the Hermes gateway.
SONAR_AUTHORIZED_SENDERS=npub1replace_me
REPOSITORY_ALLOWLIST=owner/repository,owner/another-repository
CONFIRMATION_TTL_SECONDS=300

MAX_FILES_READ=200
MAX_FILES_MODIFIED=25
MAX_DIFF_LINES=1500
MAX_TOOL_OUTPUT_BYTES=65536
COMMAND_TIMEOUT_SECONDS=900
WORKSPACE_TTL_SECONDS=3600

WORKER_IMAGE=sonar-hermes-github-sandbox:local
DOCKER_BINARY=docker
DOCKER_GID=0
WORKER_NETWORK=bridge
WORKER_MEMORY=4g
WORKER_CPUS=2
WORKER_PIDS_LIMIT=256
WORKER_WORKSPACE_SIZE=8g
BLOCKED_PATHS=.github/workflows/**,.github/actions/**,CODEOWNERS,.github/CODEOWNERS,**/CODEOWNERS,deploy/**,infrastructure/**,infra/**,k8s/**,helm/**,.git/**,.githooks/**,.env*,**/.env*,*secret*,**/*secret*,*credentials*,**/*credentials*,*token*,**/*token*,Dockerfile*,**/Dockerfile*,docker-compose*.yml,**/docker-compose*.yml,*.tf,**/*.tf,.gitlab-ci.yml

GIT_AUTHOR_NAME=Hermes GitHub Bot
GIT_AUTHOR_EMAIL=hermes-github-bot@users.noreply.github.com
RUST_LOG=info
