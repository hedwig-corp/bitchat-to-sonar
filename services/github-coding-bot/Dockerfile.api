# syntax=docker/dockerfile:1.7
FROM rust:1.92-bookworm AS builder
WORKDIR /source
COPY . .
RUN cargo build --locked --release -p coding-bot-server --bin github-coding-bot

FROM debian:bookworm-slim AS runtime
RUN apt-get update \
    && apt-get install --yes --no-install-recommends ca-certificates docker.io \
    && rm -rf /var/lib/apt/lists/* \
    && useradd --create-home --uid 10001 --shell /usr/sbin/nologin coding-bot
COPY --from=builder /source/target/release/github-coding-bot /usr/local/bin/github-coding-bot
USER 10001:10001
ENTRYPOINT ["/usr/local/bin/github-coding-bot"]
