# Sonar blog publisher config — copy to scripts/blog/.env (gitignored) and fill in.
#
# scripts/blog/publish.sh sources scripts/blog/.env automatically. The `:=`
# form only assigns when the variable is unset, so an inline override like
# `SONAR_BLOG_BUNKER=… scripts/blog/publish.sh` still wins for a one-off.
#
# Provide ONE signer. The signer's pubkey must equal BLOG_PUBKEY_HEX in
# web/src/lib/blog-data.js, or the site filters the posts out.

# NIP-46 bunker URL (signer app must be online to answer). Contains a secret —
# never commit the real .env.
: "${SONAR_BLOG_BUNKER:=bunker://<signer-pubkey>?relay=wss://relay.example/&secret=<uuid>}"
export SONAR_BLOG_BUNKER

# Alternative: a raw key instead of a bunker (leave the bunker line unset).
# : "${SONAR_BLOG_NSEC:=nsec1...}"
# export SONAR_BLOG_NSEC
