{
  "description": "Shared TranscriptOpenAction contract — KMP and SPM hosts must agree on these cases.",
  "cases": [
    {
      "name": "fully_read_live_edge",
      "input": {
        "unreadAnchorId": null,
        "unreadCountAtOpen": 0,
        "unreadAnchorAbandoned": false,
        "jumpMessageId": null
      },
      "expected": "LiveEdge"
    },
    {
      "name": "unset_capture_provisional_live_edge",
      "input": {
        "unreadAnchorId": null,
        "unreadCountAtOpen": null,
        "unreadAnchorAbandoned": false,
        "jumpMessageId": null
      },
      "expected": "LiveEdge"
    },
    {
      "name": "pending_unread_divider",
      "input": {
        "unreadAnchorId": null,
        "unreadCountAtOpen": 3,
        "unreadAnchorAbandoned": false,
        "jumpMessageId": null
      },
      "expected": "UnreadDivider"
    },
    {
      "name": "jump_wins",
      "input": {
        "unreadAnchorId": "m:unread",
        "unreadCountAtOpen": 5,
        "unreadAnchorAbandoned": false,
        "jumpMessageId": "m:search"
      },
      "expected": "{\"Jump\":\"m:search\"}"
    },
    {
      "name": "abandoned_unread_live_edge",
      "input": {
        "unreadAnchorId": null,
        "unreadCountAtOpen": 2,
        "unreadAnchorAbandoned": true,
        "jumpMessageId": null
      },
      "expected": "LiveEdge"
    },
    {
      "name": "frozen_anchor_zero_count_unread_divider",
      "input": {
        "unreadAnchorId": "m:unread",
        "unreadCountAtOpen": 0,
        "unreadAnchorAbandoned": false,
        "jumpMessageId": null
      },
      "expected": "UnreadDivider"
    },
    {
      "name": "frozen_anchor_unset_count_unread_divider",
      "input": {
        "unreadAnchorId": "m:unread",
        "unreadCountAtOpen": null,
        "unreadAnchorAbandoned": false,
        "jumpMessageId": null
      },
      "expected": "UnreadDivider"
    },
    {
      "name": "frozen_anchor_abandoned_keeps_divider",
      "input": {
        "unreadAnchorId": "m:unread",
        "unreadCountAtOpen": 2,
        "unreadAnchorAbandoned": true,
        "jumpMessageId": null
      },
      "expected": "UnreadDivider"
    }
  ]
}
